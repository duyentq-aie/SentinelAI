#!/bin/sh
# SentinelAI pre-commit hook: refuses a commit that stages
#   1. model / data / archive files: *.pt *.onnx *.engine *.mp4 *.zip *.bundle
#   2. images (*.jpg *.jpeg *.png) outside the chart folders in ALLOWED_IMAGE_DIRS below (frames and crops show people and plates)
#   3. file content with the author's mail domain, a Windows home path or the original project path (PATTERNS below; they are assembled from
#      pieces so that this file does not match itself)
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit   (README, "Pre-commit hook"). Tested by tests/test_pre_commit_hook.py.
# Do not bypass with --no-verify: unstage the file instead (git restore --staged <file>).

BLOCKED_EXT="pt onnx engine mp4 zip bundle"
IMAGE_EXT="jpg jpeg png"
# a staged image is accepted only if its path matches one of these shell patterns (everything else is refused)
ALLOWED_IMAGE_DIRS="docs/charts/* docs/figures/* experiments/*/charts/* experiments/*/plots/* experiments/*/figures/* experiments/*/box_consistency/* experiments/*/eval_*/* experiments/*/helmet_*/*"
P1="gmail.""com"
P2="C:""\\Users\\"
P3="Q:""\\SentinelAI"

set -f                                        # no globbing: the allow-list patterns are matched with case, not expanded
IFS='
'
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

fail=0
for f in $files; do
    IFS=' '                                   # the file list was split on newlines above; the inner word lists are split on spaces
    lower=$(printf '%s' "$f" | tr 'A-Z' 'a-z')
    ext=${lower##*.}
    for b in $BLOCKED_EXT; do
        if [ "$ext" = "$b" ]; then
            echo "pre-commit: refused, blocked file type (.$b): $f"
            fail=1
        fi
    done
    for i in $IMAGE_EXT; do
        if [ "$ext" = "$i" ]; then
            ok=0
            for pat in $ALLOWED_IMAGE_DIRS; do
                case "$lower" in
                    $pat) ok=1 ;;
                esac
            done
            if [ "$ok" = 0 ]; then
                echo "pre-commit: refused, image outside the chart folders ($ALLOWED_IMAGE_DIRS): $f"
                fail=1
            fi
        fi
    done
    # content of the staged version (binary files are skipped by -I); only file and line number are printed, never the matching text
    for p in "$P1" "$P2" "$P3"; do
        hits=$(git show ":$f" 2>/dev/null | grep -I -n -i -F -- "$p" | cut -d: -f1 | tr '\n' ' ')
        if [ -n "$hits" ]; then
            echo "pre-commit: refused, forbidden text in $f (line $hits)"
            fail=1
        fi
    done
done

if [ "$fail" != 0 ]; then
    echo "pre-commit: commit aborted. Unstage or fix the files above."
    exit 1
fi
exit 0
